# ---- 账本数据：每个人的，必须忽略 ----
db/*.db
db/*.db-wal
db/*.db-shm
db/*.sqlite
db/*.sqlite3
db/backups/

# ---- 真实账单原始文件：绝不入库 ----
*.xlsx
*.csv
*.zip
!db/schema.sql

# ---- 虚构样例数据：白名单精确放行 ----
# sample_data/ 里都是人工编写的教学样本（文件名带「模拟」，
# 内容首行声明「此文件为完全虚构的教学数据」），需要入库让队友能跑测试。
#
# ⚠️ 上面的 *.csv / *.zip 规则【必须保留】——真实账单随时可能被丢到任何目录。
#    这里只精确放行 sample_data/ 这一个目录，其余位置照旧全忽略。
#    gitignore 是「后出现者优先」，所以放行规则必须写在忽略规则之后。
!sample_data/
!sample_data/*.csv
!sample_data/*.zip

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# ---- 前端 ----
node_modules/
dist/
.vite/
*.local
.env
.env.*
!.env.example

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
