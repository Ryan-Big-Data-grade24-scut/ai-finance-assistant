# ---- 账本数据：每个人的真实账本数据，必须忽略 ----
db/*.db
db/*.db-wal
db/*.db-shm
db/*.sqlite
db/*.sqlite3
db/backups/
db/backup/

# ---- 真实账单原始文件：绝不入库 ----
*.xlsx
*.csv
*.zip
!db/schema.sql

# 仅允许 sample_data/ 顶层的虚构 CSV/ZIP 演示样例。
# 不允许 XLSX 或嵌套目录中的文件，以降低真实账单误提交风险。
!sample_data/
!sample_data/*.csv
!sample_data/*.zip

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# ---- 前端 ----
node_modules/
dist/
.vite/
*.local
.env
.env.*
!.env.example

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ---- 私人真实账单：绝不提交到 Git ----
/private_input/
