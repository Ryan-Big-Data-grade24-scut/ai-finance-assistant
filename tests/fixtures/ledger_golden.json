{
  "meta": {
    "name": "账本引擎黄金基线（合成数据）",
    "why": "每一次 expected 里的数字，都能在对应步骤的 notes 里被逐项加出来 —— 拿计算器就能验。",
    "privacy": "全部为虚构交易，不含任何真实账单信息。",
    "window": "2026-10-05",
    "direction_rule": "支出→支出；收入→收入；中性→支出（除非 item 含「收益发放」→收入）；退款→归零；账户搬运→归零",
    "split_rule": "仅 funding ∈ {亲情卡, 他人代付} 的交易可分裂；退款不适用"
  },

  "txs": [
    {
      "id": 1, "direction": "支出", "amount": "100.00", "funding": "自有",
      "item": "超市买菜", "tx_type": "餐饮",
      "expect_e": "100.00", "expect_i": "0.00", "expect_rule": "支出",
      "notes": "普通消费 → 一条支出腿 100.00"
    },
    {
      "id": 2, "direction": "收入", "amount": "500.00", "funding": "自有",
      "item": "工资", "tx_type": "工资",
      "expect_e": "0.00", "expect_i": "500.00", "expect_rule": "收入",
      "notes": "普通收入 → 一条收入腿 500.00"
    },
    {
      "id": 3, "direction": "中性", "amount": "50.00", "funding": "自有",
      "item": "余额宝收益发放", "tx_type": "理财",
      "expect_e": "0.00", "expect_i": "50.00", "expect_rule": "中性·收益发放",
      "notes": "中性的唯一例外：item 含「收益发放」→ 记收入 50.00"
    },
    {
      "id": 4, "direction": "中性", "amount": "30.00", "funding": "自有",
      "item": "某次扣款", "tx_type": "转账",
      "expect_e": "30.00", "expect_i": "0.00", "expect_rule": "中性·默认支出",
      "notes": "中性默认记支出 → 支出腿 30.00"
    },
    {
      "id": 5, "direction": "支出", "amount": "40.00", "funding": "亲情卡",
      "item": "给长辈买的菜", "tx_type": "餐饮",
      "expect_e": "40.00", "expect_i": "0.00", "expect_rule": "支出",
      "notes": "涉及外部额度 → 可分裂。默认先只有主腿 40.00"
    },
    {
      "id": 6, "direction": "支出", "amount": "25.00", "funding": "自有",
      "item": "地铁", "tx_type": "交通",
      "expect_e": "25.00", "expect_i": "0.00", "expect_rule": "支出",
      "notes": "普通消费 → 支出腿 25.00"
    },
    {
      "id": 7, "direction": "收入", "amount": "9.50", "funding": "自有",
      "item": "退款", "tx_type": "退款",
      "expect_e": "0.00", "expect_i": "0.00", "expect_rule": "退款·先合并归零",
      "notes": "退款优先于一切 → 零腿。平台方向是收入，但引擎判零（差 −9.50 记在审计链 ②）"
    },
    {
      "id": 8, "direction": "支出", "amount": "9.50", "funding": "自有",
      "item": "青桔骑行", "tx_type": "交通",
      "expect_e": "9.50", "expect_i": "0.00", "expect_rule": "支出",
      "notes": "没有配对退款的普通消费 → 支出腿 9.50"
    },
    {
      "id": 9, "direction": "支出", "amount": "12.00", "funding": "他人代付",
      "item": "代付商品", "tx_type": "购物",
      "expect_e": "12.00", "expect_i": "0.00", "expect_rule": "支出",
      "notes": "涉及外部额度 → 可分裂。默认先只有主腿 12.00"
    }
  ],

  "steps": [
    {
      "name": "M₀ · 退化树",
      "op": null,
      "expect": {
        "root_e": "216.50", "root_i": "550.00", "root_net": "333.50",
        "node_count": 1, "leg_count": 9
      },
      "notes": [
        "支出 = 100.00(τ1) + 30.00(τ4) + 40.00(τ5) + 25.00(τ6) + 9.50(τ8) + 12.00(τ9) = 216.50",
        "收入 = 500.00(τ2) + 50.00(τ3) = 550.00",
        "净值 = 550.00 − 216.50 = 333.50",
        "τ7 退款归零，不进任何一边",
        "节点数 1（根）、腿数 9（每笔一条主腿）"
      ]
    },
    {
      "name": "建两个分组",
      "op": {
        "op": "create_node", "parent_id": "@root", "name": "生活",
        "op_value": "ADD", "tx_ids": [1, 6]
      },
      "expect": {
        "root_e": "216.50", "root_i": "550.00", "root_net": "333.50",
        "node_count": 2, "leg_count": 9
      },
      "notes": [
        "「生活」= τ1 + τ6 = 支出 125.00",
        "根值不变 —— 只是换了归属，没有改算法",
        "节点数 1 → 2（根 + 生活）"
      ]
    },
    {
      "name": "再建一个分组并净额化",
      "op": {
        "op": "create_node", "parent_id": "@root", "name": "交通",
        "op_value": "NET", "tx_ids": [8, 9]
      },
      "expect": {
        "root_e": "216.50", "root_i": "550.00", "root_net": "333.50",
        "node_count": 3, "leg_count": 9
      },
      "notes": [
        "「交通」= NET(9.50 + 12.00) = (21.50, 0)",
        "净额化只改**呈现**，不改净值 —— 根的净值仍是 333.50",
        "这正是代数 ④「NET 重排的影响 ≡ 0」"
      ]
    },
    {
      "name": "分裂一笔亲情卡消费",
      "op": { "op": "split", "tx_id": 5 },
      "expect": {
        "root_e": "216.50", "root_i": "590.00", "root_net": "373.50",
        "node_count": 4, "leg_count": 10
      },
      "notes": [
        "τ5 分裂：主腿 40.00 支出留在原处，镜像腿 40.00 收入进「外部收入节点」",
        "收入 = 550.00 + 40.00 = 590.00",
        "净值 = 590.00 − 216.50 = 373.50",
        "节点数 +1（外部收入节点）、腿数 +1（镜像腿）",
        "⚠️ 分裂**不守恒**：镜像腿凭空多出 40.00 收入，这是代数 §2.4 的规定行为"
      ]
    },
    {
      "name": "把 τ4 挪进「生活」组",
      "op": { "op": "reassign", "tx_id": 4, "to_node_id": "@生活" },
      "expect": {
        "root_e": "216.50", "root_i": "590.00", "root_net": "373.50",
        "node_count": 4, "leg_count": 10
      },
      "notes": [
        "τ4 原来挂在根下，现在挂到「生活」下 —— 只是换归属",
        "根值不变：支出还是 216.50，收入还是 590.00",
        "「生活」现在是 100.00 + 25.00 + 30.00 = 155.00 支出"
      ]
    },
    {
      "name": "分裂一笔自有消费（不在适用域 ⇒ 拒绝）",
      "op": { "op": "split", "tx_id": 1 },
      "expect": { "rejected": true, "error_code": "SPLIT_NOT_APPLICABLE" },
      "notes": [
        "τ1 的 funding 是「自有」，不涉及外部额度 ⇒ 分裂不适用",
        "引擎拒绝并给出人话理由；账本状态不变",
        "前端不预判合法性：手势照发，后端说不行就不行"
      ]
    }
  ],

  "audit_chain_m0": {
    "s1_platform": {
      "value": "323.00",
      "notes": "支出 −100.00 −40.00 −25.00 −9.50 −12.00 + 收入 +500.00 +9.50 + 中性 0 = 323.00"
    },
    "s2_reorientation": {
      "value": "10.50",
      "notes": "中性默认支出 −30.00；中性收益发放 +50.00；退款归零 −9.50 ⇒ −30.00 + 50.00 − 9.50 = 10.50"
    },
    "s3_mirror": { "value": "0.00", "notes": "M₀ 没有分裂 ⇒ 无镜像腿" },
    "s4_net_reorder": { "value": "0.00", "notes": "净额化不改变净值 ⇒ ≡ 0" },
    "s5_root": { "value": "333.50", "notes": "550.00 − 216.50 = 333.50" },
    "closed": true,
    "notes": "① + ② + ③ + ④ = 323.00 + 10.50 + 0 + 0 = 333.50 = ⑤ 根的净值 ⇒ 闭合"
  }
}
